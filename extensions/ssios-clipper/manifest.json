{
  "manifest_version": 3,
  "name": "SSIOS Clipper",
  "version": "0.1.0",
  "description": "Send the page you are reading to SSIOS on your own computer.",
  "permissions": ["activeTab", "scripting", "storage", "cookies"],
  "host_permissions": ["https://*/*", "http://127.0.0.1/*", "https://127.0.0.1/*"],
  "action": {
    "default_title": "Send to SSIOS",
    "default_popup": "popup.html"
  }
}
